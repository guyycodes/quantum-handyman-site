# NOTE: Security headers including CSP are now configured in netlify.toml
# This file is kept for cache control settings only

/*

  # Cache Control for static assets (these still work from _headers file)
  Cache-Control: public, max-age=2592000, immutable
  
/index.html
  # Don't cache HTML
  Cache-Control: no-cache, no-store, must-revalidate
  
/*.js
  # Cache JS files
  Cache-Control: public, max-age=2592000, immutable
  
/*.css
  # Cache CSS files
  Cache-Control: public, max-age=2592000, immutable
  
/images/*
  # Cache images
  Cache-Control: public, max-age=2592000, immutable
  
/fonts/*
  # Cache fonts
  Cache-Control: public, max-age=2592000, immutable
